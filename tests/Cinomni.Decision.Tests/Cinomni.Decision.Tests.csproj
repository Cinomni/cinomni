<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Decision\Cinomni.Decision\Cinomni.Decision.csproj" />
    <ProjectReference Include="..\..\src\Modules\Decision\Cinomni.Decision.Contracts\Cinomni.Decision.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Discovery\Cinomni.Discovery\Cinomni.Discovery.csproj" />
    <ProjectReference Include="..\..\src\Modules\Discovery\Cinomni.Discovery.Contracts\Cinomni.Discovery.Contracts.csproj" />
    <!-- Catalog is registered by the test host so ICatalogSeriesQuery — the resolver Decision now
         computes episode coverage through — is the real implementation, not a stand-in. -->
    <ProjectReference Include="..\..\src\Modules\Catalog\Cinomni.Catalog\Cinomni.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\Cinomni.Catalog.Contracts\Cinomni.Catalog.Contracts.csproj" />
    <!-- Contracts only: the interactive search asks Monitoring what a target's search would be, and
         the test supplies that plan itself rather than composing the whole module. -->
    <ProjectReference Include="..\..\src\Modules\Monitoring\Cinomni.Monitoring.Contracts\Cinomni.Monitoring.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\ReleaseParsing\Cinomni.ReleaseParsing\Cinomni.ReleaseParsing.csproj" />
    <ProjectReference Include="..\..\src\Modules\ReleaseParsing\Cinomni.ReleaseParsing.Contracts\Cinomni.ReleaseParsing.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Platform\Cinomni.Kernel\Cinomni.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Platform\Cinomni.Operations\Cinomni.Operations.csproj" />
  </ItemGroup>

</Project>
