<?xml version="1.0" encoding="utf-8"?>
<!--
  Where packages may come from.

  Without this file, restore uses whatever sources the machine happens to have configured, and a
  change of source leaves no trace in a diff. <clear /> drops every inherited source, so both CI and
  a contributor machine restore this solution from exactly one place.

  Adding a source here is a supply-chain decision: it needs the same licence and provenance record
  as any other dependency (CONTRIBUTING.md, "Clean-room implementation").
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
