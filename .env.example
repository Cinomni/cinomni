# Cinomni environment contract — copy to .env and fill in.
#
#   cp .env.example .env
#
# This file is committed and must never hold a real value: every secret below is deliberately empty.
# .env itself is git-ignored. DEPLOYMENT.md explains what each setting does and what breaks without it.

# ---------------------------------------------------------------------------
# Version
# ---------------------------------------------------------------------------
# The release every image is pulled at (ghcr.io/cinomni/*). Unset, it is the version this
# docker-compose.yml was published with. Upgrading is setting a newer one, then
# `docker compose pull && docker compose up -d`, after a backup and the release notes.
#CINOMNI_IMAGE_TAG=0.1.0-alpha.1

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------
# Required. `docker compose up` refuses to start until this is set. Generate a long random value and
# keep it out of your shell history. Two characters are unsafe here whatever you do: ' ends the quoted
# password in the connection string, and $ is expanded by Compose while it reads this file, so the value
# that arrives is not the one you pasted. Letters, digits and -_.~ are always safe.
POSTGRES_PASSWORD=

# The database account and database name. Change them only before the first start: the data volume
# is created for whatever these say, and renaming afterwards leaves the old database behind.
POSTGRES_USER=cinomni
POSTGRES_DB=cinomni

# ---------------------------------------------------------------------------
# Secret storage — optional, and only needed once you store a secret
# ---------------------------------------------------------------------------
# The key Cinomni encrypts stored secrets with: today, the credential you give an indexer (its API
# key, or the password for a definition-backed login). Nothing else uses it yet, and an installation
# that never stores one never needs this.
#
# Leave it empty and the installation starts normally, says so once in the log, and refuses to store
# a credential — the attempt fails with a message naming this variable rather than saving anything
# unencrypted. Everything else keeps working, including indexers that need no credential at all.
#
# 32 bytes, base64. Generate one with:
#   openssl rand -base64 32
#
# Treat it like the database password. Losing it does not lose the installation, but every secret
# stored under it becomes unreadable and has to be entered again — Cinomni reports that as "not
# configured" rather than pretending to decrypt. Changing it has the same effect, so rotate it
# deliberately and re-enter what it protected.
#CINOMNI_SECRET_KEY=

# Reverse proxy addresses or CIDR ranges whose X-Forwarded-For header may be believed, comma-separated.
# Set this whenever you widen CINOMNI_BIND_ADDRESS: the rate limiter on the login route counts
# requests per client address, and behind an undeclared proxy every client arrives as the proxy --
# so the limit meant for one attacker locks out the whole household instead. Leave it empty when
# nothing sits in front; a proxy left out of this list is not believed, which fails safe.
#
# Setting this is only half the job. The proxy MUST write the header itself
# (nginx: proxy_set_header X-Forwarded-For $remote_addr;). A proxy that relays a client-supplied
# X-Forwarded-For untouched -- which a bare proxy_pass does -- lets any caller choose their own
# rate-limit bucket per request, and from Cinomni's side that is indistinguishable from a header the
# proxy wrote. Caddy and Traefik do this correctly by default; nginx does not.
#CINOMNI_TRUSTED_PROXIES=172.18.0.0/16

# Set to true only when TLS terminates in front of Cinomni. It is what makes Cinomni send
# Strict-Transport-Security, which tells a browser to refuse plain HTTP to this host for six months.
# Turning it on for a deployment that is not actually behind TLS locks every browser in the household
# out of the server until each one clears its HSTS state, so it is off unless you say otherwise.
#CINOMNI_HSTS=true

# How many proxies stand between a client and Cinomni. Hops, not addresses: two edge proxies
# deployed for redundancy are still one hop. Only raise it for a real chain.
#CINOMNI_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Torrent egress — required, and it is a decision
# ---------------------------------------------------------------------------
# Required. `docker compose up` refuses to start until this says one of two words, because acquisition
# without having chosen is not something Cinomni will do quietly for you.
#
#   direct — the torrent sidecar reaches trackers and peers over THIS MACHINE'S OWN INTERNET
#            CONNECTION. Your household's public address is what the swarm sees and what a tracker
#            records for every torrent you take part in. Nothing in Cinomni hides it.
#   vpn    — you also start with the VPN overlay:
#              docker compose -f docker-compose.yml -f docker-compose.vpn.yml up -d
#            That puts the sidecar inside a tunnel container's network namespace, binds libtorrent to
#            the tunnel device, and holds every download when the traffic stops verifiably leaving
#            through it. Downloads keep their progress and resume by themselves. Fill in the VPN
#            section at the bottom of this file.
#
# The value is recorded on the sidecar container and is not enforced: it is the record of a choice.
CINOMNI_TORRENT_EGRESS=

# Required. A credential on the torrent sidecar's gRPC control port, which adds torrents, decides where
# they are written and removes them with their files. `docker compose up` refuses to start until it is
# set, in either topology. Generate one and never reuse it:
#   openssl rand -hex 32
CINOMNI_SIDECAR_CONTROL_TOKEN=

# ---------------------------------------------------------------------------
# HTTP — where the web client is reachable
# ---------------------------------------------------------------------------
# The image terminates plain HTTP only, so the default publishes on loopback. Put a reverse proxy in
# front and only then widen this (0.0.0.0 for every interface, or a specific address).
CINOMNI_BIND_ADDRESS=127.0.0.1
CINOMNI_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Storage — read "The storage contract" in DEPLOYMENT.md before changing this
# ---------------------------------------------------------------------------
# One directory, mounted at /data in both containers, holding library/ and downloads/. It must be a
# single filesystem: an import hardlinks from downloads/ into library/, and a link cannot cross one.
CINOMNI_DATA_DIR=./data

# The account both containers run as; it must own CINOMNI_DATA_DIR. 1654 is the non-root account the
# application's base image provides. Set both to your own id if the media directory already exists:
#   id -u ; id -g
CINOMNI_UID=1654
CINOMNI_GID=1654

# Local time zone for timestamps in the interface and the logs.
TZ=UTC

# ---------------------------------------------------------------------------
# Database backups
# ---------------------------------------------------------------------------
# Cinomni dumps its own database on a schedule and keeps the newest few. It backs up the DATABASE —
# accounts, the library index, playback progress, requests, and why each release was chosen. It does
# NOT back up your media files: copying CINOMNI_DATA_DIR is your own storage job. Read "Backup and
# restore" in DEPLOYMENT.md before you rely on either.
#
# A dump is a CREDENTIAL STORE. It contains delivery-channel URLs, indexer addresses that commonly
# embed API keys, password verifiers and session token hashes, and it is not encrypted. Wherever it
# lands must be treated the way you treat this file.
#
# Unset means a Docker volume named cinomni-backups. Point it at a host path to copy dumps off this
# machine, which you should: a backup that only exists on the disk that failed is not a backup.
#
# Keep that host path OUTSIDE CINOMNI_DATA_DIR. Nothing checks this for you: inside the container the
# backup directory is always /data/backups whatever host path is behind it, so the startup check —
# which compares the container's paths — cannot see where you mounted it from. Putting it under
# CINOMNI_DATA_DIR/library puts an unencrypted credential store in the tree you share and rsync;
# putting it under CINOMNI_DATA_DIR/downloads also hands it to the torrent sidecar, the least trusted
# process here. The directory must be owned by CINOMNI_UID:CINOMNI_GID, like the data directory.
#CINOMNI_BACKUP_DIR=/srv/cinomni-backups

# How many backups are kept, how often one is taken, and whether the schedule runs at all. Taking one
# by hand always works: docker compose exec cinomni dotnet Cinomni.Host.dll backup create
CINOMNI_BACKUP_KEEP=7
CINOMNI_BACKUP_INTERVAL=1.00:00:00
CINOMNI_BACKUP_ENABLED=true

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------
CINOMNI_CPUS=4.0
CINOMNI_MEMORY=2g
SIDECAR_CPUS=2.0
SIDECAR_MEMORY=1g
# Streams converted at once (transcode or remux): on the whole node, and per account. A request past
# either is refused with the reason. Software transcoding a 1080p film takes one to two cores, so on
# the default CPUS=4.0 without a hardware overlay, 2 is the honest number.
CINOMNI_MAX_TRANSCODES=4
CINOMNI_MAX_TRANSCODES_PER_ACCOUNT=2

# ---------------------------------------------------------------------------
# Provider credentials — all optional
# ---------------------------------------------------------------------------
# Each one is optional and each one disables something when left empty. The application starts either
# way and logs the name of every key it did not find.
#
# TMDB_API_KEY          — no key: no metadata for movies and no poster art from TMDB.
# TVDB_API_KEY/TVDB_PIN — no key: no season and episode structure from TheTVDB, so series added from
#                         that provider arrive without their episode tree.
# OPENSUBTITLES_API_KEY — no key: subtitle searches find nothing; everything else still works.
TMDB_API_KEY=
TVDB_API_KEY=
TVDB_PIN=
OPENSUBTITLES_API_KEY=

# ---------------------------------------------------------------------------
# Telemetry — optional, and off until you name a collector
# ---------------------------------------------------------------------------
# Leave the endpoint empty and nothing leaves the process: no exporter is registered, no listener
# attaches, and the instrumentation costs nothing. Telemetry departing a self-hosted installation is
# a decision you make, not a default you have to find and switch off.
#
# Set it to an OpenTelemetry collector you run and Cinomni exports traces, metrics and log records to
# it over OTLP — one trace per acquisition, across the outbox and the command queue. There is no
# scrape endpoint and no Prometheus exporter: run a collector and let it expose one. What is exported
# carries no secret, no api key, no indexer URL or host, no info hash, no path, no title and no
# search term. A provider URL keeps its path and loses both the query string, because that is where
# the key is, and the host, because it names the tracker. A log record is exported as its message
# template — `Library root {Root} is not accessible.` — never as the rendered line: the values it
# interpolates, and any exception message or stack trace, stay on this machine and are read with
# `docker compose logs`.
#
# The collector has to be reachable from the application container — join it to the `edge` network,
# or publish it on the host and point at that address. A value that is not an absolute http(s) URL
# stops the start rather than exporting silently to nowhere.
#CINOMNI_OTLP_ENDPOINT=http://otel-collector:4317

# `grpc` (port 4317, the collector default) or `httpprotobuf` (port 4318, for a collector behind a
# proxy that will not carry h2c). Anything else stops the start.
#CINOMNI_OTLP_PROTOCOL=grpc

# Emit log lines as JSON. Independent of the exporter: a file-based log shipper wants this without
# wanting OTLP. Trace and span ids are attached to every line either way.
#CINOMNI_JSON_LOGS=false

# ---------------------------------------------------------------------------
# VPN — opt-in. Everything below is ignored unless you apply the overlay
# ---------------------------------------------------------------------------
#   docker compose -f docker-compose.yml -f docker-compose.vpn.yml up -d
#
# Set CINOMNI_TORRENT_EGRESS=vpn above when you use it. With the overlay off, none of these are read
# and Cinomni needs no tunnel — local development and the default topology are unaffected.
#
# Required by the overlay, and it aborts the start until it is set, for the same reason
# POSTGRES_PASSWORD does: there is no value Cinomni can pick for you. (CINOMNI_SIDECAR_CONTROL_TOKEN,
# above, is required here too; inside the tunnel the control port is bound in a network you do not own.)
#
#   VPN_SERVICE_PROVIDER — which provider the tunnel image should connect to.
#VPN_SERVICE_PROVIDER=

# The tunnel protocol and the credentials for it. WireGuard is the default; for OpenVPN set
# VPN_TYPE=openvpn and fill in the OPENVPN_ pair instead. These go to the tunnel image unread —
# Cinomni does not parse, rewrite or validate them, and never logs them.
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_ADDRESSES=
#WIREGUARD_PRESHARED_KEY=
#OPENVPN_USER=
#OPENVPN_PASSWORD=
#VPN_SERVER_COUNTRIES=
#VPN_SERVER_CITIES=

# What Cinomni does when torrent traffic stops verifiably leaving through the tunnel. Read by the
# sidecar and by the application, which accept the same three words in any casing:
#
#   block           — the default, and the only one that fails closed. The first observation that is
#                     not a verification holds every download, including one that could not be taken
#                     at all. A held download cannot be resumed by hand; the tunnel coming back is
#                     what releases it. The sidecar refuses to start without its tunnel.
#   pause-and-alert — a single failed observation is absorbed; a sustained one holds the downloads,
#                     and you may knowingly resume one anyway. The override is recorded.
#   ignore          — observe and report, change nothing. Downloads keep running over whatever route
#                     exists, which may be your own connection.
#
# Anything below `block` is logged as a warning at every start and shown on the health surface. A
# value that is not one of the three becomes `block` — a typo cannot weaken an installation.
#CINOMNI_TUNNEL_LOSS_POLICY=block

# The tunnel interface: the one the tunnel image creates, the one libtorrent binds to, and the one
# Cinomni verifies. `tun0` for OpenVPN, `wg0` for a WireGuard setup that names it so.
#CINOMNI_TUNNEL_DEVICE=tun0

# How often the application re-checks. Shorter finds a drop sooner and asks the sidecar more often;
# the sidecar has already stopped its own traffic on the first failed observation either way.
#CINOMNI_TUNNEL_POLL_INTERVAL=00:00:30

# Advanced, and rarely needed.
#   CINOMNI_VPN_IMAGE            — a tunnel image other than the pinned default. It must create the
#                                  interface above, hold the default route through it, filter
#                                  everything else, stay filtered when the tunnel is down, and
#                                  declare a HEALTHCHECK.
#   CINOMNI_SIDECAR_LISTEN       — the address the control port binds inside the tunnel namespace.
#   CINOMNI_VPN_OUTBOUND_SUBNETS — only if Cinomni's own network is on a subnet the tunnel container
#                                  does not treat as local.
#CINOMNI_VPN_IMAGE=
#CINOMNI_SIDECAR_LISTEN=0.0.0.0:50051
#CINOMNI_VPN_OUTBOUND_SUBNETS=

# ---------------------------------------------------------------------------
# Hardware transcoding — opt-in. Read by docker-compose.hwaccel.yml only
# ---------------------------------------------------------------------------
#   docker compose -f docker-compose.yml -f docker-compose.hwaccel.yml up -d
#
# Required by that overlay, and only that overlay: the container's fixed non-root uid belongs to no
# group on the host's render device by default, so without this the device exists inside the
# container and every open on it still fails with EACCES. Find it with:
#   getent group render
#CINOMNI_RENDER_GID=
#
# Whether hardware transcoding is actually used — auto-detected at every start and on by default — is
# a live setting, not an environment variable: Console → Settings → Playback → Hardware transcoding.
# DEPLOYMENT.md section 9 explains both overlays (docker-compose.hwaccel.yml for VAAPI/QSV,
# docker-compose.nvidia.yml for NVENC — that one needs nvidia-container-toolkit on the host and no
# variable here at all) and how to read what a session actually used.

# --- DNS for indexers (optional) ---------------------------------------------------------------
# If your provider blocks sites by answering their names with 127.0.0.1 (an indexer test then says
# "resolves to a private or local network"), resolve through public resolvers instead. Uncomment
# COMPOSE_FILE to add docker-compose.dns.yml (use ";" instead of ":" on Windows).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dns.yml
# CINOMNI_DNS_PRIMARY=1.1.1.1
# CINOMNI_DNS_SECONDARY=9.9.9.9
