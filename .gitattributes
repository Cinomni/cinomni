# Normalize line endings: LF in the repo, checkout adapts to the OS.
* text=auto eol=lf

# Binaries: no conversion
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.dll binary
*.so binary
*.fastresume binary

# Scripts that require a specific line ending
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
