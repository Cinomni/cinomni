<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cinomni.Monitoring.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cinomni.Monitoring.Contracts\Cinomni.Monitoring.Contracts.csproj" />
    <!-- Neutral search contracts (SearchRequested/SearchCriterion) it produces. -->
    <ProjectReference Include="..\..\..\Shared\Cinomni.Search.Contracts\Cinomni.Search.Contracts.csproj" />
    <!-- Catalog.Contracts only (WorkAdded/SeriesStructureChanged, ICatalogQuery, ICatalogSeriesQuery,
         WorkId) — never Catalog internals. -->
    <ProjectReference Include="..\..\Catalog\Cinomni.Catalog.Contracts\Cinomni.Catalog.Contracts.csproj" />
    <!-- Import.Contracts only (the MediaAvailable event that clears IsMissing). Acyclic: Import does
         not reference Monitoring, and Import.Contracts references the kernel alone. -->
    <ProjectReference Include="..\..\Import\Cinomni.Import.Contracts\Cinomni.Import.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Platform\Cinomni.Kernel\Cinomni.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Platform\Cinomni.Operations\Cinomni.Operations.csproj" />
    <ProjectReference Include="..\..\Decision\Cinomni.Decision.Contracts\Cinomni.Decision.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
