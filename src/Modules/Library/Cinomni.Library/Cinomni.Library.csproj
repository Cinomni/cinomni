<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cinomni.Library.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cinomni.Library.Contracts\Cinomni.Library.Contracts.csproj" />
    <!-- Interface dep (→i): an asset is visible when its work is, and Catalog is the one authority on that. -->
    <ProjectReference Include="..\..\Catalog\Cinomni.Catalog.Contracts\Cinomni.Catalog.Contracts.csproj" />
    <!-- Event dep (⇠e): Import's MediaAvailable carries the asset descriptor (work/target correlation,
         landed file, ffprobe streams). Contracts-only — Library touches no Import internals. -->
    <ProjectReference Include="..\..\Import\Cinomni.Import.Contracts\Cinomni.Import.Contracts.csproj" />
    <!-- Event dep (⇠e): Subtitles' SubtitleAvailable enriches the asset with an external track.
         Contracts-only — no cycle (Subtitles references only our Contracts). -->
    <ProjectReference Include="..\..\Subtitles\Cinomni.Subtitles.Contracts\Cinomni.Subtitles.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Platform\Cinomni.Kernel\Cinomni.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Platform\Cinomni.Operations\Cinomni.Operations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
