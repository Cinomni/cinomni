<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cinomni.Requests.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cinomni.Requests.Contracts\Cinomni.Requests.Contracts.csproj" />
    <!-- Interface deps (→i): catalogues the approved title and refreshes its metadata through the public
         contracts; reads Catalog to reject a request for something already in the library, and to tell
         whether the work is already playable. Event dep (⇠e): Catalog's WorkAvailable closes the request.
         Contracts-only — never mutates another module's tables. The authorization policy the endpoints
         gate on comes from the kernel, so this module does not depend on Identity. Monitoring (→i):
         an approved request switches on the watch of a title that was already catalogued unwatched. -->
    <ProjectReference Include="..\..\Catalog\Cinomni.Catalog.Contracts\Cinomni.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Metadata\Cinomni.Metadata.Contracts\Cinomni.Metadata.Contracts.csproj" />
    <ProjectReference Include="..\..\Monitoring\Cinomni.Monitoring.Contracts\Cinomni.Monitoring.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Platform\Cinomni.Kernel\Cinomni.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Platform\Cinomni.Operations\Cinomni.Operations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
