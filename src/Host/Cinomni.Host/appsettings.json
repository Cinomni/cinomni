{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "cinomni",
    "Otlp": {
      "Endpoint": "",
      "Protocol": "grpc"
    },
    "Traces": {
      "SampleRatio": 1.0
    },
    "Logs": {
      "Json": false
    },
    "Readiness": {
      "MinFreeDiskBytes": 5368709120,
      "Timeout": "00:00:03"
    }
  },
  "Downloads": {
    "Sidecar": {
      "Address": "http://localhost:50051",
      "StagingPath": "/data/downloads",
      "CallTimeout": "00:00:15"
    },
    "Transfers": {
      "StallTimeout": "1.00:00:00",
      "SeedRatioLimit": 1.0,
      "SeedTimeLimit": "7.00:00:00"
    },
    "Tunnel": {
      "Device": "",
      "LossPolicy": "Block",
      "PollInterval": "00:00:30",
      "UnverifiedThreshold": 2,
      "VerifiedThreshold": 2
    }
  },
  "Import": {
    "LibraryRoot": "/data/library",
    "Ffprobe": {
      "BinaryPath": "ffprobe"
    }
  },
  "Playback": {
    "TranscodeRoot": "/data/transcodes",
    "MaxConcurrentTranscodes": 4,
    "MaxTranscodesPerAccount": 2,
    "TranscodeIdleTimeout": "00:05:00",
    "MaxTranscodeLifetime": "06:00:00",
    "Ffmpeg": {
      "BinaryPath": "ffmpeg",
      "SegmentSeconds": 6
    }
  },
  "Backup": {
    "Enabled": true,
    "Root": "/data/backups",
    "KeepCount": 7,
    "Interval": "1.00:00:00",
    "Timeout": "02:00:00",
    "PgDumpPath": "pg_dump",
    "PgRestorePath": "pg_restore"
  },
  "Retention": {
    "OutboxRetention": "14.00:00:00",
    "CompletedCommandRetention": "30.00:00:00",
    "FailedCommandRetention": "180.00:00:00",
    "BatchSize": 5000,
    "Interval": "1.00:00:00",
    "Discovery": {
      "SearchRetention": "30.00:00:00",
      "Interval": "1.00:00:00"
    },
    "Decision": {
      "EvaluationRetention": "90.00:00:00",
      "Interval": "1.00:00:00"
    },
    "Metadata": {
      "SnapshotRetention": "30.00:00:00",
      "Interval": "1.00:00:00"
    },
    "ReleaseParsing": {
      "ParseRetention": "180.00:00:00",
      "Interval": "1.00:00:00"
    },
    "Notifications": {
      "NotificationRetention": "180.00:00:00",
      "Interval": "1.00:00:00"
    },
    "Identity": {
      "SessionGrace": "30.00:00:00",
      "Interval": "1.00:00:00"
    },
    "Playback": {
      "SessionRetention": "90.00:00:00",
      "Interval": "1.00:00:00"
    },
    "Downloads": {
      "CheckpointRetention": "30.00:00:00",
      "Interval": "1.00:00:00"
    }
  }
}
