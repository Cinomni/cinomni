<Project>
  <!-- Common configuration for all .NET projects (.NET 10 + ASP.NET Core). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The version this source is. The one place it is written: a release bumps it here (see
         Versioning in CHANGELOG.md), and an image build may override it with CINOMNI_VERSION. The SDK
         derives the four-part AssemblyVersion from the part before the suffix. -->
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>
</Project>
